# ===== 本地測試設定（資料只存在本機 SQLite + Redis）=====

# Telegram Bot Token（必填，向 @BotFather 申請後貼上）
TELEGRAM_BOT_TOKEN=

# Google Sheets API（測試階段先留空；之後要雲端備份再填這兩項）
GOOGLE_SHEETS_CREDENTIALS=./json/credentials.json
GOOGLE_SHEETS_ID=

# Redis（本機預設即可；沒密碼就留空）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# SQLite 資料庫（本地檔案，會自動建立）
DB_PATH=./app/data/accounting.db

# 環境
NODE_ENV=development
